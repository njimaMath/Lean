import Lake
open Lake DSL

package NjimaLean where
  version := v!"0.1.0"
  keywords := #["math"]
  leanOptions := #[
    ⟨`pp.unicode.fun, true⟩,
    ⟨`relaxedAutoImplicit, false⟩,
    ⟨`weak.linter.mathlibStandardSet, true⟩,
    ⟨`maxSynthPendingDepth, 3⟩,
    -- Preserve Lean 4.32 elaboration for this legacy project, with normal kernel checking.
    ⟨`backward.isDefEq.respectTransparency.types, false⟩,
    ⟨`experimental.module, true⟩]

require SYKBlueprint from "SYK_CLT/Blueprint"

require VersoBlueprint from git
  "https://github.com/leanprover/verso-blueprint" @ "4943d3335ffa9221a39949e60836a8ad5dc2a456"

-- Preserve the parser's extern_lib linkage in Verso's Windows shared library.
require MD4Lean from git
  "https://github.com/acmepjz/md4lean" @ "6a3fb240133bcb7e1a066fdc784b3fdc304e3fc5"

-- Keep Mathlib last so its compatible transitive revisions take precedence.
require mathlib from git
  "https://github.com/leanprover-community/mathlib4" @ "v4.35.0"

lean_lib DisjointPaths where
  srcDir := "Research"
  roots := #[`Disjoint_paths.Main_Disjoint]
  globs := #[.submodules `Disjoint_paths]

-- Keep this project's SpinGlass modules separate from GeneralizedLatala's copies.
-- Both legacy aliases share one job, so a combined build cannot start two consumers.
target PerceptronWorkspace pkg : Unit := Job.async do
  proc {
    cmd := "lake"
    args := #["build"]
    cwd := some (pkg.dir / "research_public/perceptronFixed/Lean")
    env := #[("LEAN_NUM_THREADS", some "1")]
  }

target PerceptronFixed2 pkg : Unit := do
  return (← pkg.fetchTargetJob `PerceptronWorkspace).map (fun _ => ())

lean_lib percolation where
  srcDir := "."
  -- FPPtex/*.listings.lean is generated by LaTeX, not a Lean module.
  globs := #[.one `percolation.PercolationZd,
    .one `percolation.FPP.FPP_Basics,
    .one `percolation.FPP.FPP_Basics_aristotle,
    .one `percolation.chemicalDistance.chemicalBasics]

-- The FPP model and its local consumers retain their existing qualified imports.
lean_lib FPP where
  srcDir := "."
  globs := #[.submodules `research_public.FPP_tail]

lean_lib KignmanSubadditiveErgodic where
  srcDir := "Research"
  globs := #[.submodules `KignmanSubadditiveErgodic]

lean_lib oriented_animal where
  srcDir := "Research"
  globs := #[.submodules `oriented_animal]

-- Retain the legacy root commands while SYK keeps its own Lake project.
-- Every alias checks the complete library, including its supporting modules.
def buildSykLibrary : FetchM (Job Unit) := do
  let some lib ← findLeanLib? `SYK | error "SYK library is unavailable"
  lib.leanArts.fetch

target SYK _pkg : Unit := do
  let library ← buildSykLibrary
  let some blueprint ← findLeanLib? `SYKBlueprint | error "SYK Blueprint is unavailable"
  return library.mix (← blueprint.leanArts.fetch)

target Model _pkg : Unit := buildSykLibrary
target SuperConcentration _pkg : Unit := buildSykLibrary
target CLT _pkg : Unit := buildSykLibrary
target Annealed_FE _pkg : Unit := buildSykLibrary
target Universality _pkg : Unit := buildSykLibrary

target PerceptronGibbs pkg : Unit := do
  return (← pkg.fetchTargetJob `PerceptronWorkspace).map (fun _ => ())

-- Public generalized Latała formalization.
lean_lib GeneralizedLatala where
  srcDir := "research_public/generalizedLatala"
  globs := #[
    .submodules `SpinGlass,
    .submodules `GeneralizedLatala,
    .one `mainresult_latala
  ]

-- RSAT sources use the root project's shared mathlib in `.lake/packages`.
lean_lib RSAT where
  srcDir := "research_public/RSAT"
  globs := #[.submodules `Lemmas]

-- Give the public endpoint its own module name, separate from the root Main.
@[default_target]
lean_lib RSATMain where
  srcDir := "research_public"
  roots := #[`RSAT.Main]

-- Scalar annealed TAP formalization and its independent proof tasks.
lean_lib TAPAnnealed where
  srcDir := "Research"
  roots := #[`TAP_ANNEALED.Lemmas.All]
  globs := #[.one `TAP_ANNEALED.Main_overlap,
    .submodules `TAP_ANNEALED.Lemmas]
